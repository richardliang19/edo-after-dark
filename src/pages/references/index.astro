---
import Base from '../../layouts/Base.astro';
import refs from '../../data/references.json';
import { ordered, artworkApa } from '../../lib/data';
import { observationSources } from '../../data/observation';

const em = (s: string) => s.replace(/\*(.+?)\*/g, '<em>$1</em>');
const artworkRefs = ordered.map((a) => ({ a, apa: artworkApa(a) }));
---
<Base title="參考資料">
  <div class="page">
    <div class="page-head">
      <span class="seal">參考資料</span>
      <h1>參考資料</h1>
      <p>作品、解說與研究來源分列。2026 年 11 月 18 日重新查核；遇到無法核讀全文的頁面會另行標示。學術書籍若只取得出版社摘要，不視為已閱讀全書。</p>
    </div>

    <section class="cat">
      <h2>作品圖像</h2>
      <ul>
        {artworkRefs.map(({ a, apa }) => (
          <li>{apa ? <span set:html={em(apa)} /> : <span class="pending">《{a.title}》：作品來源待查證</span>}</li>
        ))}
      </ul>
    </section>

    <section class="cat" id="observation-sources">
      <h2>作品精讀與活動二的解說來源</h2>
      <p>活動二的答題線索已整理在站內作品頁，以下館藏與機構頁面供延伸閱讀和查核，不是作答前必須閱讀的材料。各條目區分本頁印本、同圖異印本與一般歷史背景。《月之岬》的兩份解說對活動階段有不同理解，本展保留差異。</p>
      <ul>{Object.values(observationSources).filter(s => !('unverified' in s)).map((s) => <li>{s.institution}. (n.d.). <em>{s.title}</em> ({s.record}). Retrieved November 18, 2026, from <a href={s.url} target="_blank" rel="noopener">{s.url}</a><small>{s.scope}</small></li>)}</ul>
      <details><summary>舊版引用：本次未完成全文核對</summary><ul>{Object.values(observationSources).filter(s => 'unverified' in s).map(s => <li>{s.institution}｜<a href={s.url} target="_blank" rel="noopener">{s.title}</a><small>{s.scope}。嘗試核對日期：2026-11-18；修訂版不以這些頁面支撐答案。</small></li>)}</ul></details>
    </section>

    {refs.map((c) => (
      <section class="cat">
        <h2>{c.category}</h2>
        <ul>
          {c.items.map((r) => (
            <li><span set:html={em(r.apa)} />{r.url && <a class="open-source" href={r.url} target="_blank" rel="noopener"> 開啟來源 ↗</a>}{r.note && <small>{r.note}</small>}</li>
          ))}
        </ul>
      </section>
    ))}
  </div>
</Base>

<style>
  .cat { margin-bottom: 8vh; }
  .cat h2 { font-size: 26px; margin-bottom: 16px; }
  ul { list-style: none; }
  li { padding: 14px 0 14px 2em; text-indent: -2em; border-top: 1px solid var(--line); color: var(--paper-2); font-size: 15px; line-height: 1.8; word-break: break-word; }
  li small { display: block; text-indent: 0; color: var(--gold); font-size: 12px; margin-top: 4px; }
  .pending { color: var(--mute); }
  #observation-sources { scroll-margin-top: calc(var(--nav-h) + 20px); }
  .cat > p { color: var(--paper-2); font-size: 14px; margin-bottom: 16px; }
</style>
