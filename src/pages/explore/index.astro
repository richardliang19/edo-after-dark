---
import Base from '../../layouts/Base.astro';
import MapComparison from '../../components/MapComparison.astro';
import { u } from '../../lib/url';
import { ordered, times, regions, perspectives, regionName, confidence, thumb } from '../../lib/data';

const filters = [
  { key: 'time', label: '時間', options: times.map((t) => ({ value: t.time, label: t.time + ' ' + t.label, desc: '' })) },
  { key: 'region', label: '區域', options: regions.map((r) => ({ value: r.id, label: r.name, desc: r.function })) },
  { key: 'perspective', label: '人物視角', options: perspectives.map((p) => ({ value: p.id, label: p.name, desc: p.desc })) },
];
---
<Base title="時空探索">
  <div class="explore">
    <header class="explore-head">
      <span class="seal">時空探索</span>
      <h1>在江戶與東京之間</h1>
      <p>沿著河岸、街道與畫中的地名，比較昔日江戶與今日東京，找到夜裡的故事。</p>
    </header>
    <section class="filters" aria-label="篩選作品與地圖標記">
      {filters.map((filter) => (
        <fieldset class="filter-row" id={filter.key === 'perspective' ? 'perspective' : undefined}>
          <legend>{filter.label}</legend>
          <div class="chips" data-key={filter.key}>
            <button type="button" class="on" data-v="all" aria-pressed="true">全部</button>
            {filter.options.map((option) => <button type="button" data-v={option.value} title={option.desc || undefined} aria-pressed="false">{option.label}</button>)}
          </div>
        </fieldset>
      ))}
      <p class="caveat">人物視角是策展分析工具；沒有直接證據的內容會標示為歷史背景推論。</p>
    </section>
    <MapComparison />
    <section class="results" aria-labelledby="results-title">
      <div class="results-head">
        <h2 id="results-title">地圖裡的夜間故事</h2>
        <p role="status"><span id="count" class="num">{ordered.length}</span> 件作品</p>
      </div>
      <ul class="list">
        {ordered.map((a) => (
          <li data-artwork-id={a.id} data-time={a.curatorialTime ?? ''} data-region={a.region} data-perspective={a.perspectives.join(' ')}>
            <a class="artwork-link" href={u('artworks/' + a.id + '/')}>
              {a.image ? <img src={thumb(a.image.src, 330)} alt="" width="72" height="104" loading="lazy" /> : <span class="noimg"></span>}
              <div>
                <span class="num time">{a.curatorialTime ?? '序章'}</span>
                <strong>{a.title}</strong>
                <small>{a.location.historicalName}・{regionName(a.region)}</small>
                <small class:list={['conf', { hypothetical: a.location.confidence === 'hypothetical' }]}>{confidence[a.location.confidence]}</small>
              </div>
            </a>
            {a.location.lat !== null && a.location.lng !== null
              ? <button class="locate" type="button" data-locate={a.id} aria-label={'在兩幅地圖上定位：' + a.title} disabled>在地圖上找 →</button>
              : <p class="pending">位置待考，暫無地圖標記</p>}
          </li>
        ))}
      </ul>
      <p class="empty" hidden>這個組合沒有對應的作品，換個條件試試。</p>
    </section>
  </div>
</Base>

<style>
  .explore { max-width: 1600px; margin: 0 auto; padding: calc(var(--nav-h) + 44px) var(--gutter) 80px; }
  .explore-head { margin-bottom: 30px; }
  h1 { font-size: clamp(34px, 5vw, 54px); margin: 16px 0 12px; }
  .explore-head p { font-size: 15px; color: var(--paper-2); max-width: 720px; }
  .filters { border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); padding: 18px 0; margin-bottom: 32px; }
  .filter-row { border: 0; min-width: 0; margin-bottom: 12px; padding-left: 72px; position: relative; }
  .filter-row legend { position: absolute; left: 0; top: 4px; font-size: 14px; color: var(--paper-2); }
  #perspective { scroll-margin-top: calc(var(--nav-h) + 20px); }
  .chips { display: flex; flex-wrap: wrap; gap: 7px; }
  .chips button { background: none; border: 1px solid var(--line); color: var(--paper-2); font-family: var(--serif); font-size: 13px; padding: 5px 12px; border-radius: 999px; cursor: pointer; transition: background .2s, color .2s, border-color .2s; }
  .chips button:hover { border-color: var(--paper-2); }
  .chips button.on { background: var(--paper); color: var(--ink); border-color: var(--paper); }
  button:focus-visible, a:focus-visible { outline: 2px solid var(--gold); outline-offset: 4px; }
  .caveat { font-size: 12px; color: var(--mute); padding-left: 72px; line-height: 1.7; }
  .results { margin-top: 42px; }
  .results-head { display: flex; align-items: baseline; justify-content: space-between; gap: 20px; margin-bottom: 20px; }
  .results-head h2 { font-size: 27px; }
  .results-head p { color: var(--mute); font-size: 14px; white-space: nowrap; }
  .results-head .num { color: var(--gold); font-size: 22px; }
  .list { list-style: none; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 14px; }
  .list li { min-width: 0; background: var(--ink-2); border: 1px solid var(--line); padding: 18px; transition: border-color .2s; }
  .list li.selected { border-color: var(--gold); }
  .list li[hidden] { display: none; }
  .artwork-link { display: flex; gap: 16px; text-decoration: none; }
  .list img, .list .noimg { width: 72px; height: 104px; object-fit: contain; flex: 0 0 auto; background: var(--ink); }
  .list strong { display: block; font-family: var(--serif-display); font-weight: 400; font-size: 20px; line-height: 1.5; margin-bottom: 5px; }
  .list small { display: block; color: var(--mute); font-size: 12px; line-height: 1.7; }
  .list .time { color: var(--gold); font-size: 14px; }
  .list .hypothetical { color: var(--gold); }
  .artwork-link:hover strong { color: var(--gold); }
  .locate { background: none; border: 0; border-top: 1px solid var(--line); color: var(--paper-2); width: 100%; text-align: right; font: 12px var(--serif); padding: 12px 0 0; margin-top: 15px; cursor: pointer; }
  .locate:hover { color: var(--gold); }
  .locate:disabled { opacity: .45; cursor: default; }
  .pending { font-size: 12px; color: var(--mute); margin-top: 15px; padding-top: 8px; border-top: 1px solid var(--line); }
  .empty { color: var(--mute); font-size: 14px; padding: 20px 0; }
  @media (max-width: 1100px) { .list { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 700px) {
    .explore { padding-top: calc(var(--nav-h) + 28px); }
    .filter-row { padding-left: 0; margin-bottom: 15px; }
    .filter-row legend { position: static; margin-bottom: 7px; }
    .caveat { padding-left: 0; }
    .list { grid-template-columns: 1fr; }
    .results-head h2 { font-size: 23px; }
  }
</style>

<script>
  const state: Record<string, string> = { time: 'all', region: 'all', perspective: 'all' };
  const initialParams = new URLSearchParams(location.search);
  const items = [...document.querySelectorAll<HTMLLIElement>('.list li')];
  const count = document.getElementById('count')!;
  const empty = document.querySelector<HTMLElement>('.empty')!;
  const apply = () => {
    const ids: string[] = [];
    items.forEach((li) => {
      const ok = (state.time === 'all' || li.dataset.time === state.time)
        && (state.region === 'all' || li.dataset.region === state.region)
        && (state.perspective === 'all' || (li.dataset.perspective ?? '').split(' ').includes(state.perspective));
      li.hidden = !ok;
      if (ok) ids.push(li.dataset.artworkId!);
    });
    count.textContent = String(ids.length);
    empty.hidden = ids.length > 0;
    document.dispatchEvent(new CustomEvent('explore:filter', { detail: { ids } }));
  };
  document.querySelectorAll<HTMLElement>('.chips').forEach((group) => {
    const key = group.dataset.key!;
    const btns = [...group.querySelectorAll<HTMLButtonElement>('button')];
    const requested = initialParams.get(key);
    if (requested && btns.some((button) => button.dataset.v === requested)) state[key] = requested;
    btns.forEach((button) => {
      const selected = button.dataset.v === state[key];
      button.classList.toggle('on', selected);
      button.setAttribute('aria-pressed', String(selected));
    });
    btns.forEach((b) => b.addEventListener('click', () => {
      btns.forEach((x) => {
        x.classList.toggle('on', x === b);
        x.setAttribute('aria-pressed', String(x === b));
      });
      state[key] = b.dataset.v!;
      const url = new URL(location.href);
      Object.entries(state).forEach(([name, value]) => {
        if (value === 'all') url.searchParams.delete(name);
        else url.searchParams.set(name, value);
      });
      history.replaceState(null, '', url);
      apply();
    }));
  });
  apply();
</script>
