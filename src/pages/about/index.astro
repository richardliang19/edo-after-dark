---
import Base from '../../layouts/Base.astro';
---
<Base title="關於我們">
  <div class="page">
    <div class="page-head">
      <span class="seal">關於我們</span>
      <h1>關於我們</h1>
      <p>策展團隊、工作分配與製作過程。</p>
    </div>

    <section class="block reveal">
      <h2>團隊介紹</h2>
      <p class="todo">待補：組員姓名、負責項目與一句話介紹。</p>
    </section>
    <section class="block reveal">
      <h2>工作分配</h2>
      <p class="todo">待補：工作分配表。</p>
    </section>
    <section class="block reveal">
      <h2>工作進度甘特圖</h2>
      <p class="todo">待補：甘特圖。</p>
    </section>
    <section class="block reveal">
      <h2>報告討論紀錄</h2>
      <p class="todo">待補：每次討論的日期、出席者、決議事項。</p>
    </section>
    <section class="block reveal">
      <h2>主視覺海報</h2>
      <p class="todo">待補：主視覺海報圖檔與參考出處。</p>
    </section>
  </div>
</Base>

<style>
  .block { padding: 36px 0; border-top: 1px solid var(--line); }
  .block h2 { font-size: 28px; margin-bottom: 14px; }
</style>
